#!/usr/bin/env bash
# Drop-in for `nix flake archive --json <ref>` that never touches the network.
#
# `nix flake archive` copies EVERY input of a flake into the store, so for a
# `github:owner/repo/<rev>` input it downloads archive/<rev>.tar.gz. With the store
# closed and the network namespace up -- how the tests run -- that fails:
#
#   unpacking 'github:esp0xdeadbeef/network-compiler/22dbbbc...' into the Git cache...
#   error: unable to download
#     'https://github.com/esp0xdeadbeef/network-compiler/archive/22dbbbc....tar.gz':
#     Could not resolve host: github.com
#
# and the revision that fails is not the test's: it comes from a sibling's lock. A
# github: tarball and a git checkout of the same revision are DIFFERENT store paths, so
# the sibling checkout CI already made can never satisfy it.
#
# CI checks out every sibling next to the repository under test, so an input's path is
# that directory. Sibling-first; `nix flake archive` only when the sibling is absent (a
# developer machine), which is the single case where resolving the locked graph is right.
#
# Output matches `nix flake archive --json` for the part the tests read:
#   {"inputs": {"<name>": {"path": "<path>"}}, "path": "<flake root>"}
set -euo pipefail

ref=""
for arg in "$@"; do
  case "${arg}" in
    path:*) ref="${arg}" ;;
    --json|--no-write-lock-file|--no-update-lock-file) ;;
    "") ;;
  esac
done
[[ -n "${ref}" ]] || exec nix flake archive "$@"

root="${ref#path:}"
[[ -d "${root}" ]] || exec nix flake archive "$@"
parent="$(cd "${root}/.." && pwd)"

missing=0
json="$(python3 - "${root}" "${parent}" <<'PY'
import json, pathlib, sys

root = pathlib.Path(sys.argv[1])
parent = pathlib.Path(sys.argv[2])
lock = root / "flake.lock"
inputs = {}
missing = 0
if lock.is_file():
    try:
        nodes = json.loads(lock.read_text()).get("nodes", {})
    except json.JSONDecodeError:
        nodes = {}
    for name in ((nodes.get("root") or {}).get("inputs") or {}):
        sibling = parent / name
        if (sibling / "flake.nix").is_file():
            inputs[name] = {"path": str(sibling)}
        else:
            missing += 1
print(json.dumps({"inputs": inputs, "path": str(root), "missing": missing}))
PY
)"

missing="$(python3 -c 'import json,sys; print(json.load(sys.stdin).pop("missing"))' <<<"${json}")"
if (( missing > 0 )); then
  # AN INPUT WITH NO SIBLING CHECKOUT, most often `nixpkgs` itself.
  #
  # A flake under test can pin a nixpkgs revision that no current lock in the fleet
  # names -- a fixture's own lock, or a sibling pinned at an older revision. There is no
  # `../nixpkgs` directory to answer with, and the store holds one nixpkgs, so the real
  # `nix flake archive` would fetch archive/<rev>.tar.gz:
  #
  #   error: Failed to open archive (Source threw exception: error: unable to download
  #     'https://github.com/NixOS/nixpkgs/archive/0182a361...tar.gz':
  #     Could not resolve host: github.com)
  #
  # measured in network-forwarding-model FS-171-HDS-010-SDS-010-SMS-010. Answering with
  # THIS repository's nixpkgs -- already in the store, because the warm step put it
  # there -- keeps the evaluation offline. The alternative is a network fetch for a
  # nixpkgs the test does not assert anything about.
  repo_nixpkgs="$(nix eval --offline --raw --impure \
    --expr "(builtins.getFlake \"path:${root}\").inputs.nixpkgs.outPath" 2>/dev/null || true)"
  if [[ -z "${repo_nixpkgs}" ]]; then
    printf 'flake-archive-offline: %s input(s) have no sibling checkout and the repository nixpkgs could not be read; falling back\n' "${missing}" >&2
    exec nix flake archive "$@"
  fi
  json="$(python3 - "${json}" "${repo_nixpkgs}" "${parent}" "${root}" <<'PY'
import json, pathlib, sys

data, repo_nixpkgs, parent, root = sys.argv[1:5]
resolved = json.loads(data)
resolved.pop("missing", None)
inputs = resolved["inputs"]
lock = pathlib.Path(root, "flake.lock")
if lock.is_file():
    try:
        nodes = json.loads(lock.read_text()).get("nodes", {})
    except json.JSONDecodeError:
        nodes = {}
    for name in ((nodes.get("root") or {}).get("inputs") or {}):
        if name in inputs:
            continue
        # `nixpkgs` is the one input a sibling checkout cannot answer for.
        inputs[name] = {"path": repo_nixpkgs}
print(json.dumps(resolved))
PY
)"
fi
printf '%s\n' "${json}"
